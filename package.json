{
  "name": "commit-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action for committing changes via the GitHub or Forgejo API",
  "license": "MIT",
  "repository": "github:Profiidev/commit-action",
  "main": "./dist/index.js",
  "scripts": {
    "build": "vite build",
    "format": "oxfmt",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:watch": "vitest --project unit --project integration"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@octokit/core": "^7.0.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.72.0",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.5",
    "openapi-format": "1.34.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
